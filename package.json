{
  "name": "openstore",
  "version": "0.1.0",
  "private": true,
  "description": "OpenStore — The Open-Source Software Discovery & Hands-Free Execution Platform",
  "author": "Charan Sai <openstore@proton.me> (https://github.com/Charannsai)",
  "license": "MIT",
  "homepage": "https://github.com/Charannsai/openstore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Charannsai/openstore.git"
  },
  "bugs": {
    "url": "https://github.com/Charannsai/openstore/issues"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:desktop": "npm --workspace=@openstore/desktop run electron:dev",
    "dev:web": "npm --workspace=@openstore/web run dev",
    "build:desktop": "npm --workspace=@openstore/desktop run electron:build",
    "build:web": "npm --workspace=@openstore/web run build",
    "electron:dev": "npm --workspace=@openstore/desktop run electron:dev",
    "electron:build": "npm --workspace=@openstore/desktop run electron:build",
    "dev": "npm --workspace=@openstore/desktop run electron:dev",
    "build": "npm --workspace=@openstore/desktop run build"
  },
  "overrides": {
    "app-builder-lib": {
      "@noble/hashes": "1.4.0"
    },
    "@noble/hashes": "1.4.0"
  }
}
