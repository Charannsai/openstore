{
  "name": "@openstore/desktop",
  "version": "0.2.3",
  "private": true,
  "description": "OpenStore — Native Desktop Application & Hands-Free Execution Engine",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently -k \"cross-env NODE_ENV=development next dev -p 3002\" \"wait-on http://localhost:3002 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "next build && electron-builder -p never",
    "electron:start": "electron ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "41.7.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "author": "OpenStore Community <openstore@proton.me>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Charannsai/openstore.git"
  },
  "build": {
    "appId": "com.openstore.app",
    "productName": "OpenStore",
    "electronVersion": "41.7.1",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png"
    }
  }
}
